# Address the app listens on
APP_HOST=0.0.0.0
# Port of the app
APP_PORT=6355
# Turn on LLM explanations (false: template texts only)
LLM_ENABLED=true
# Default Ollama model
LLM_MODEL=gemma4:e2b
# Address of the Ollama server
LLM_BASE_URL=http://localhost:11434
# LLM answer timeout, seconds
LLM_TIMEOUT_S=20
# Admin token for the page /admin, at least 20 characters (scripts/setup.py creates it when it is empty)
ADMIN_TOKEN=
# Send cookies only over HTTPS. Without this line it is false, and true when a certificate is set below
# COOKIE_SECURE=false
# Certificate and key (PEM): then uvicorn serves HTTPS
APP_SSL_CERTFILE=
APP_SSL_KEYFILE=
# true when your own reverse proxy (Caddy, nginx) is in front of the app: the client address comes from X-Forwarded-For
TRUST_PROXY=false
